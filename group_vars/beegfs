ansible_port: 22
ansible_user: "{{ lookup('env', 'ANSIBLE_ACCOUNT file=.env') }}"
ansible_become: true
ansible_become_method: sudo
ansible_python_interpreter: /usr/bin/python3
cluster: beegfs
network_prefix: "{{ lookup('env', 'BEEGFS_NETWORK_PREFIX file=.env') }}"
beegfs_version: "8.1.0"
beegfs_storage: "RAID"
beegfs_meta: "RAID"
beegfs_mgmt_ip: "{{ lookup('env', 'BEEGFS_MGMT_IP file=.env') }}"
beegfs_mgmt_host: "as-bg01"
beegfs_portshift: 20	# connPortShift
beegfs_port_begin: 8023	# 8000 plust connPortShift
beegfs_port_end: 8030	# 8010 plust connPortShift
beegfs_mountpath: ""
beegfs_mountdir: "data"
